{
    "outputDirectory": "public",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "routes": [
        {
            "src": "/build/.vite/manifest.json",
            "headers": { "cache-control": "max-age=31536000" },
            "dest": "/build/.vite/manifest.json"
        },
        {
            "src": "/build/manifest.json",
            "headers": { "cache-control": "max-age=31536000" },
            "dest": "/build/.vite/manifest.json"
        },
        {
            "src": "/build/(.*)",
            "headers": { "cache-control": "max-age=31536000" },
            "dest": "/build/$1"
        },
        {
            "src": "/(css|js|images|fonts)/(.*)",
            "headers": { "cache-control": "max-age=31536000" },
            "dest": "/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/(.*\\.(css|js|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json))",
            "headers": { "cache-control": "max-age=31536000" },
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "VITE_APP_ENV": "production",
        "MIX_PUSHER_APP_KEY": "",
        "MIX_PUSHER_APP_CLUSTER": "",
        "ASSET_URL": "",
        "APP_FORCE_HTTPS": "true"
    },
    "buildCommand": "npm install && npm run vercel-build"
}